# LocalTrack-Konfiguration (Umgebungsvariablen, Prefix LOCALTRACK_)
LOCALTRACK_PORT=8080
LOCALTRACK_DATA_DIR=/var/lib/localtrack/data
LOCALTRACK_DATABASE_URL=postgresql+psycopg://localtrack:PASSWORD@127.0.0.1:5432/localtrack
# Optional: eigenes Frontend-Build-Verzeichnis
# LOCALTRACK_FRONTEND_DIST=/opt/localtrack/frontend/dist
