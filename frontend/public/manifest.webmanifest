{
  "name": "LocalTrack",
  "short_name": "LocalTrack",
  "description": "Lokale Sport-Aktivitäten: offline aufzeichnen, auf dem eigenen Server synchronisieren.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0f172a",
